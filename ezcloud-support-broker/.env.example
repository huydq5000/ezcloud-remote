EZID_ISSUER=https://dev-id.ezcloud.vn
EZID_AUDIENCE=
EZID_SUPPORTER_ROLES=
EZCLOUD_JWT_ISS=ezcloud-support
# HS256 secret used by the broker today. Not a client_secret. Leave empty in git.
EZCLOUD_JWT_SECRET=
# Reserved for the Ed25519 key file. Do not put a private key in this example.
EZCLOUD_JWT_PRIVATE_KEY_PATH=
DATABASE_PATH=./support.sqlite
LISTEN_ADDR=127.0.0.1:8080
ACL_BASE_URL=https://acl.ezcloud.vn/api/integration/v1
# Example secret ref only. Never commit a real acl_ key.
ACL_API_KEY=
ACL_MODE=off
ACL_BREAK_GLASS_EMAILS=
SETTINGS_ENC_KEY=
